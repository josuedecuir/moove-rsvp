# Puerto (Railway lo asigna solo, no lo toques en producción)
PORT=3000

# Dominio público donde vive la app (para armar links en los correos)
PUBLIC_BASE_URL=http://localhost:3000

# Ruta del archivo SQLite. En Railway, monta un Volume y apunta esto a esa ruta
# (ej. /data/rsvp.db) para que los datos sobrevivan a los redeploys.
DB_PATH=./src/data/rsvp.db

# Carpeta donde se guardan las fotos de INE. También debe vivir en el Volume.
UPLOADS_DIR=./uploads

# Login del panel admin (usuario y contraseña únicos, compartidos por el equipo)
ADMIN_USER=moove
ADMIN_PASS=cambia-esta-contraseña

# Secreto para firmar la cookie de sesión del admin (cualquier string largo y aleatorio)
SESSION_SECRET=cambia-este-secreto-tambien

# Aviso de privacidad de Moove (link público)
PRIVACY_URL=https://moove.mx/aviso-privacidad

# --- Correo de confirmación (opcional para probar en local, requerido en prod) ---
# SMTP de donde se manda el correo automático de confirmación al RSVP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Moove <noreply@moove.mx>"
