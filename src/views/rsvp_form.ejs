<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { title }) %>
</head>
<body>
<div class="page">
<div class="wrap">
  <%- include('partials/logo') %>

  <div class="kicker">Moove Private · Confirmación</div>
  <div class="title">¿Podrás<br>acompañarnos<br>el <%= eventDate %>?</div>
  <div class="hint"><%= eventCity %>. Necesitamos algunos datos para dejarte en la lista.</div>

  <% if (error) { %>
    <div class="error-box"><%= error %></div>
  <% } %>

  <form action="/rsvp/<%= contact.token %>/yes" method="POST" enctype="multipart/form-data">
    <div class="field">
      <label>Nombre completo</label>
      <input type="text" name="nombre" placeholder="Nombre y apellidos" required
        value="<%= contact.nombre || '' %>">
    </div>
    <div class="field">
      <label>Empresa / razón social</label>
      <input type="text" name="empresa" placeholder="Nombre de tu empresa" required
        value="<%= contact.empresa || '' %>">
    </div>
    <div class="field">
      <label>Teléfono</label>
      <input type="tel" name="telefono" placeholder="55 1234 5678" required
        value="<%= contact.telefono || '' %>">
    </div>
    <div class="field">
      <label>Identificación oficial (INE)</label>
      <label class="field-file" id="ine-drop">
        <input type="file" name="ine" accept="image/*" id="ine-input" <%= contact.ine_path ? '' : 'required' %>>
        <span>Toca para subir una foto de tu INE</span>
        <div class="fname" id="ine-fname"><%= contact.ine_path ? 'Ya tenemos una foto guardada. Sube otra solo si quieres cambiarla.' : '' %></div>
      </label>
    </div>

    <div class="checkbox-row">
      <input type="checkbox" name="privacy" id="privacy" value="1" required>
      <label for="privacy">
        He leído y acepto el <a href="<%= privacyUrl %>" target="_blank" rel="noopener">aviso de privacidad de Moove</a>.
      </label>
    </div>

    <button type="submit" class="btn-next btn-primary">Confirmar asistencia</button>
  </form>

  <hr class="divider">

  <form action="/rsvp/<%= contact.token %>/no" method="POST">
    <button type="submit" class="btn-next" style="width:100%;">No podré asistir esta vez</button>
  </form>
</div>
</div>

<script>
  const fileInput = document.getElementById('ine-input');
  const fname = document.getElementById('ine-fname');
  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) {
      fname.textContent = fileInput.files[0].name;
    }
  });
</script>
</body>
</html>
