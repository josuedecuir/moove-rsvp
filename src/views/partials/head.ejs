<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title><%= typeof title !== 'undefined' ? title : 'Moove Private' %></title>
<%
  const _ogTitle = typeof ogTitle !== 'undefined' ? ogTitle : 'Moove Private';
  const _ogDescription = typeof ogDescription !== 'undefined' ? ogDescription : 'Invitación privada. Evento exclusivo — confirma tu asistencia.';
  const _ogImage = typeof ogImage !== 'undefined' ? ogImage : (baseUrl + '/og-image.jpg');
  const _ogUrl = typeof ogUrl !== 'undefined' ? ogUrl : baseUrl;
%>
<meta property="og:type" content="website">
<meta property="og:title" content="<%= _ogTitle %>">
<meta property="og:description" content="<%= _ogDescription %>">
<meta property="og:image" content="<%= _ogImage %>">
<meta property="og:url" content="<%= _ogUrl %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= _ogTitle %>">
<meta name="twitter:description" content="<%= _ogDescription %>">
<meta name="twitter:image" content="<%= _ogImage %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#050605; --surface:#0B0D0B; --border:#1A1F1A; --border2:#2A302A;
  --text:#F4F1EA; --muted:#8D9687; --subtle:#ADB7A6; --body:#C7C4BB; --accent:#F4F1EA;
  --danger:#C77;
}
html,body{min-height:100vh;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-weight:300;-webkit-font-smoothing:antialiased;}
.page{min-height:100vh;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 20px;position:relative;overflow:hidden;}
.wrap{width:100%;max-width:480px;position:relative;z-index:1;animation:fadeUp .5s cubic-bezier(.22,1,.36,1) both;}
.wrap.wide{max-width:760px;}
@keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
.logo-wrap{margin-bottom:56px;text-align:left;}
.logo-wrap img,.logo-wrap svg{height:22px;opacity:1;}
.kicker{font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);margin-bottom:20px;}
.title{font-family:'EB Garamond',Georgia,serif;font-size:clamp(34px,7vw,54px);line-height:1.05;letter-spacing:-.03em;color:var(--text);margin-bottom:20px;}
.hint{font-size:13px;color:var(--muted);margin-bottom:36px;line-height:1.6;}
.body-copy{font-family:'EB Garamond',Georgia,serif;font-size:18px;line-height:1.75;color:var(--subtle);margin-bottom:16px;}
.divider{border:none;border-top:1px solid var(--border2);margin:36px 0;}
.field{margin-bottom:26px;}
.field label{display:block;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;}
.field input,.field textarea{width:100%;background:transparent;border:none;border-bottom:1px solid var(--border2);padding:10px 0;color:var(--text);font-family:'DM Sans',sans-serif;font-size:16px;font-weight:300;outline:none;transition:border-color .25s;border-radius:0;-webkit-appearance:none;}
.field input::placeholder{color:var(--border2);}
.field input:focus,.field textarea:focus{border-bottom-color:var(--muted);}
.field-file{border:1px dashed var(--border2);padding:20px;text-align:center;cursor:pointer;transition:border-color .2s;}
.field-file:hover{border-color:var(--muted);}
.field-file input{display:none;}
.field-file .fname{color:var(--subtle);font-size:13px;margin-top:8px;word-break:break-all;}
.yn-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:28px;}
.yn-btn{padding:18px 0;background:transparent;border:1px solid var(--border2);color:var(--subtle);font-size:13px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:all .2s;text-decoration:none;text-align:center;display:block;}
.yn-btn:hover{border-color:var(--muted);color:var(--text);}
.btn-next{background:transparent;border:1px solid var(--border2);color:var(--subtle);font-size:12px;letter-spacing:.14em;text-transform:uppercase;padding:14px 30px;cursor:pointer;transition:all .25s;text-decoration:none;display:inline-block;font-family:'DM Sans',sans-serif;}
.btn-next:hover:not(:disabled){background:var(--text);border-color:var(--text);color:var(--bg);}
.btn-next:disabled{opacity:.3;cursor:not-allowed;}
.btn-primary{background:var(--text);border-color:var(--text);color:var(--bg);}
.checkbox-row{display:flex;align-items:flex-start;gap:10px;margin-bottom:28px;}
.checkbox-row input{margin-top:4px;}
.checkbox-row label{font-size:12.5px;color:var(--muted);line-height:1.6;}
.checkbox-row a{color:var(--subtle);}
.error-box{border:1px solid var(--danger);color:#E3B0B0;font-size:13px;padding:14px 16px;margin-bottom:24px;}
.share-box{border:1px solid var(--border2);padding:20px;margin-top:24px;}
.share-box .label{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;}
.share-box .link{font-size:13px;color:var(--subtle);word-break:break-all;}
.copy-btn{margin-top:14px;background:none;border:1px solid var(--border2);color:var(--subtle);font-size:11px;letter-spacing:.12em;text-transform:uppercase;padding:10px 16px;cursor:pointer;}
.copy-btn:hover{border-color:var(--muted);color:var(--text);}
@media(max-width:520px){ .page{padding:40px 24px;} }
</style>
