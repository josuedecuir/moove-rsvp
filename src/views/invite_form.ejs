<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { title }) %>
</head>
<body>
<div class="page">
<div class="wrap">
  <%- include('partials/logo') %>

  <div class="kicker">Invitación privada</div>
  <div class="title"><%= inviterName %> te invitó.</div>
  <div class="hint">
    Evento privado de Moove — <%= eventDate %>, <%= eventCity %>. Confirma tu asistencia para quedar en la lista.
  </div>

  <% if (error) { %>
    <div class="error-box"><%= error %></div>
  <% } %>

  <form action="/invite/<%= shareToken %>" method="POST" enctype="multipart/form-data">
    <div class="field">
      <label>Nombre completo</label>
      <input type="text" name="nombre" placeholder="Nombre y apellidos" required>
    </div>
    <div class="field">
      <label>Teléfono</label>
      <input type="tel" name="telefono" placeholder="55 1234 5678" required>
    </div>
    <div class="field">
      <label>Identificación oficial (INE)</label>
      <label class="field-file" id="ine-drop">
        <input type="file" name="ine" accept="image/*" id="ine-input" required>
        <span>Toca para subir una foto de tu INE</span>
        <div class="fname" id="ine-fname"></div>
      </label>
    </div>

    <div class="checkbox-row">
      <input type="checkbox" name="privacy" id="privacy" value="1" required>
      <label for="privacy">
        He leído y acepto el <a href="<%= privacyUrl %>" target="_blank" rel="noopener">aviso de privacidad de Moove</a>.
      </label>
    </div>

    <button type="submit" class="btn-next btn-primary">Confirmar mi asistencia</button>
  </form>
</div>
</div>
<script>
  const fileInput = document.getElementById('ine-input');
  const fname = document.getElementById('ine-fname');
  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) fname.textContent = fileInput.files[0].name;
  });
</script>
</body>
</html>
