<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { title }) %>
<style>
  .page{ align-items:stretch; justify-content:flex-start; padding:48px 24px; }
  .topbar{ display:flex; align-items:center; justify-content:space-between; max-width:1000px; margin:0 auto 32px; width:100%; }
  .stats{ display:flex; gap:28px; flex-wrap:wrap; max-width:1000px; margin:0 auto 40px; width:100%; }
  .stat{ border:1px solid var(--border2); padding:16px 22px; min-width:110px; }
  .stat .n{ font-family:'EB Garamond',Georgia,serif; font-size:30px; color:var(--text); }
  .stat .l{ font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); margin-top:4px; }
  table.contacts{ width:100%; max-width:1000px; margin:0 auto; border-collapse:collapse; }
  table.contacts th{ text-align:left; font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); padding:10px 12px; border-bottom:1px solid var(--border2); }
  table.contacts td{ padding:12px; border-bottom:1px solid var(--border); font-size:13px; color:var(--subtle); vertical-align:top; }
  .status-pill{ font-size:10px; letter-spacing:.1em; text-transform:uppercase; padding:4px 8px; border:1px solid var(--border2); display:inline-block; }
  .status-yes{ color:#B7D9B0; border-color:#33502F; }
  .status-no{ color:#D9B0B0; border-color:#503131; }
  .status-pending{ color:var(--muted); }
  .socio-row{ font-size:12px; color:var(--muted); padding-left:16px; }
  .ine-link{ color:var(--subtle); font-size:12px; }
  .logout-form{ display:inline; }
  .logout-btn{ background:none;border:1px solid var(--border2);color:var(--subtle);font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:8px 16px;cursor:pointer; }
  .add-contact{ max-width:1000px; margin:0 auto 40px; width:100%; border:1px solid var(--border2); padding:20px 22px; }
  .add-contact .label{ font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:14px; }
  .add-contact form{ display:flex; gap:14px; flex-wrap:wrap; align-items:flex-end; }
  .add-contact .f{ flex:1; min-width:160px; }
  .add-contact .f label{ display:block; font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom:6px; }
  .add-contact .f input{ width:100%; background:transparent; border:none; border-bottom:1px solid var(--border2); padding:8px 0; color:var(--text); font-family:'DM Sans',sans-serif; font-size:14px; outline:none; }
  .rsvp-link{ font-size:11px; color:var(--muted); word-break:break-all; cursor:pointer; }
  .rsvp-link:hover{ color:var(--subtle); text-decoration:underline; }
  .rsvp-link.copied{ color:#B7D9B0; }
  .edit-row{ display:none; background:rgba(255,255,255,0.02); }
  .edit-row.open{ display:table-row; }
  .edit-row td{ padding:14px 12px; }
  .edit-row form{ display:flex; gap:14px; flex-wrap:wrap; align-items:flex-end; }
  .edit-row .f{ flex:1; min-width:140px; }
  .edit-row .f label{ display:block; font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom:6px; }
  .edit-row .f input{ width:100%; background:transparent; border:none; border-bottom:1px solid var(--border2); padding:8px 0; color:var(--text); font-family:'DM Sans',sans-serif; font-size:13px; outline:none; }
  .row-actions{ display:flex; gap:8px; }
</style>
</head>
<body>
<div class="page">
  <div class="topbar">
    <div>
      <%- include('partials/logo') %>
      <div class="kicker" style="margin:0;">Panel de RSVP · Moove Private</div>
    </div>
    <div style="display:flex;gap:10px;align-items:center;">
      <button type="button" class="logout-btn" onclick="downloadCsv()">Descargar CSV (Mailchimp)</button>
      <form class="logout-form" action="/admin/logout" method="POST">
        <button class="logout-btn" type="submit">Cerrar sesión</button>
      </form>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><div class="n"><%= stats.total %></div><div class="l">Contactos</div></div>
    <div class="stat"><div class="n"><%= stats.yes %></div><div class="l">Confirmados</div></div>
    <div class="stat"><div class="n"><%= stats.no %></div><div class="l">Declinaron</div></div>
    <div class="stat"><div class="n"><%= stats.pending %></div><div class="l">Pendientes</div></div>
    <div class="stat"><div class="n"><%= stats.socios %></div><div class="l">Socios invitados</div></div>
  </div>

  <div class="add-contact">
    <div class="label">Agregar contacto manual</div>
    <form action="/admin/contacts" method="POST">
      <div class="f">
        <label>Nombre</label>
        <input type="text" name="firstname" placeholder="Daniel">
      </div>
      <div class="f">
        <label>Correo</label>
        <input type="email" name="email" placeholder="daniel@moove.mx" required>
      </div>
      <div class="f">
        <label>Empresa</label>
        <input type="text" name="empresa" placeholder="Opcional">
      </div>
      <button type="submit" class="logout-btn" style="height:38px;">Agregar</button>
    </form>
  </div>

  <div class="add-contact">
    <div class="label">Importar CSV en lote (para Mailchimp)</div>
    <div style="font-size:12px;color:var(--muted);margin-bottom:14px;">
      Columnas: <code>nombre,email,empresa,telefono</code> (empresa y teléfono opcionales; el formato viejo <code>firstname,email,empresa</code> también funciona).
      Si un correo ya existe: si sigue "pending" se actualizan sus datos con los del CSV, si ya respondió no se toca — en ningún caso se duplica, siempre se reutiliza su link de siempre.
      Al enviar se importa y esta misma página se recarga con la tabla actualizada — para el CSV con <code>RSVP_URL</code> listo para Mailchimp usa el botón "Descargar CSV (Mailchimp)" de arriba (opción "Todos").
    </div>
    <% if (typeof importSummary !== 'undefined' && importSummary) { %>
      <div style="font-size:12px;color:#B7D9B0;margin-bottom:14px;border:1px solid #33502F;padding:10px 14px;">
        Import listo — creados: <%= importSummary.creados %>, actualizados: <%= importSummary.actualizados %>, ya existían (no tocados): <%= importSummary.existentes %><% if (importSummary.omitidos) { %>, omitidos (sin correo): <%= importSummary.omitidos %><% } %>.
      </div>
    <% } %>
    <form action="/admin/contacts/import" method="POST" enctype="multipart/form-data" style="display:flex;gap:14px;align-items:flex-end;">
      <div class="f">
        <label>Archivo CSV</label>
        <input type="file" name="file" accept=".csv" required style="color:var(--text);font-size:13px;">
      </div>
      <button type="submit" class="logout-btn" style="height:38px;">Importar</button>
    </form>
  </div>

  <table class="contacts">
    <thead>
      <tr>
        <th>Contacto</th>
        <th>Empresa</th>
        <th>Teléfono</th>
        <th>Estatus</th>
        <th>INE</th>
        <th>Link RSVP</th>
        <th>Respondió</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% contacts.forEach(function(c) { %>
        <tr>
          <td>
            <strong style="color:var(--text);"><%= c.nombre || c.firstname || '—' %></strong><br>
            <span style="color:var(--muted);"><%= c.email || '' %></span>
          </td>
          <td><%= c.empresa || '—' %></td>
          <td><%= c.telefono || '—' %></td>
          <td>
            <span class="status-pill status-<%= c.status %>"><%= c.status %></span>
          </td>
          <td>
            <% if (c.ine_path) { %>
              <a class="ine-link" href="/admin/file/<%= c.ine_path %>" target="_blank" rel="noopener">Ver INE</a>
            <% } else { %>
              —
            <% } %>
          </td>
          <td><span class="rsvp-link" onclick="copyRsvpLink(this)" title="Click para copiar"><%= baseUrl %>/rsvp/<%= c.token %></span></td>
          <td><%= c.responded_at || '—' %></td>
          <td>
            <div class="row-actions">
              <button type="button" class="logout-btn" style="padding:6px 10px;font-size:10px;" onclick="toggleEdit(<%= c.id %>)">Editar</button>
              <form action="/admin/contacts/<%= c.id %>/delete" method="POST" onsubmit="return confirm('¿Borrar a ' + <%- JSON.stringify(c.nombre || c.firstname || c.email) %> + ' y sus socios?');">
                <button type="submit" class="logout-btn" style="padding:6px 10px;font-size:10px;">Borrar</button>
              </form>
            </div>
          </td>
        </tr>
        <tr class="edit-row" id="edit-row-<%= c.id %>">
          <td colspan="8">
            <form action="/admin/contacts/<%= c.id %>/edit" method="POST">
              <div class="f">
                <label>Nombre</label>
                <input type="text" name="nombre" value="<%= c.nombre || c.firstname || '' %>">
              </div>
              <div class="f">
                <label>Empresa</label>
                <input type="text" name="empresa" value="<%= c.empresa || '' %>">
              </div>
              <div class="f">
                <label>Teléfono</label>
                <input type="text" name="telefono" value="<%= c.telefono || '' %>">
              </div>
              <button type="submit" class="logout-btn" style="height:38px;">Guardar</button>
              <button type="button" class="logout-btn" style="height:38px;" onclick="toggleEdit(<%= c.id %>)">Cancelar</button>
            </form>
          </td>
        </tr>
        <% (sociosByContact[c.id] || []).forEach(function(s) { %>
          <tr class="socio-row">
            <td>↳ <%= s.nombre %><br><span style="color:var(--muted);"><%= s.email || '' %></span></td>
            <td>socio invitado</td>
            <td><%= s.telefono %></td>
            <td>—</td>
            <td>
              <% if (s.ine_front_path) { %>
                <a class="ine-link" href="/admin/file/<%= s.ine_front_path %>" target="_blank" rel="noopener">Frente</a>
              <% } else { %>—<% } %>
              <% if (s.ine_back_path) { %>
                · <a class="ine-link" href="/admin/file/<%= s.ine_back_path %>" target="_blank" rel="noopener">Reverso</a>
              <% } else { %> · —<% } %>
            </td>
            <td>—</td>
            <td><%= s.created_at %></td>
            <td></td>
          </tr>
        <% }); %>
      <% }); %>
    </tbody>
  </table>
</div>
<script>
function downloadCsv(){
  const todos = confirm('¿Descargar el CSV?\n\nAceptar = TODOS los contactos, con su RSVP_URL (para la campaña de invitación)\nCancelar = Solo confirmados que sí van + sus invitados (para sincronizar la lista final)');
  window.location.href = '/admin/export.csv?scope=' + (todos ? 'todos' : 'confirmados');
}
function toggleEdit(id){
  document.getElementById('edit-row-' + id).classList.toggle('open');
}
function copyRsvpLink(el){
  const text = el.textContent.trim();
  navigator.clipboard.writeText(text).then(function(){
    const original = el.textContent;
    el.textContent = 'Copiado ✓';
    el.classList.add('copied');
    setTimeout(function(){
      el.textContent = original;
      el.classList.remove('copied');
    }, 1200);
  });
}
</script>
</body>
</html>
